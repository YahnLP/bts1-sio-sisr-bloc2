ateur.</p></body></html>"}}},"mgmt":{"comms":[],"location":"","contact":"","syslogd":false,"trapd":false},"v6":{"ifs":[{"name":"Ethernet0","autoconf":true,"addrs":[]}],"statics":[]},"label":""},{"id":"D6","type":"pc","model":"pc-win","name":"PC3","x":700,"y":400,"powered":true,"ifaces":[{"name":"Ethernet0","ip":"192.168.1.13","mask":"255.255.255.0","dhcp":false}],"gw":"","dns":[],"domain":"","allowIcmpEcho":true,"wifi":{"ssid":"","key":""},"hosts":{},"dhcpd":{"enabled":false,"excluded":[],"pools":[]},"dnsd":{"enabled":false,"records":[],"forwarders":[]},"httpd":{"enabled":false,"https":false,"pages":{"/":{"type":"text/html; charset=utf-8","body":"<html><head><title>PC3</title></head><body><h1>Bienvenue sur PC3</h1><p>Serveur web du simulateur.</p></body></html>"}}},"mgmt":{"comms":[],"location":"","contact":"","syslogd":false,"trapd":false},"v6":{"ifs":[{"name":"Ethernet0","autoconf":true,"addrs":[]}],"statics":[]},"label":""}],"links":[{"a":["D4","Ethernet0"],"b":["D1","FastEthernet0/3"],"type":"straight"},{"a":["D5","Ethernet0"],"b":["D2","FastEthernet0/3"],"type":"straight"},{"a":["D6","Ethernet0"],"b":["D3","FastEthernet0/3"],"type":"straight"},{"a":["D1","FastEthernet0/1"],"b":["D2","FastEthernet0/1"],"type":"cross"},{"a":["D1","FastEthernet0/2"],"b":["D3","FastEthernet0/1"],"type":"cross"},{"a":["D2","FastEthernet0/2"],"b":["D3","FastEthernet0/2"],"type":"cross"}],"notes":"","tpfile":{"v":1,"id":"cours-s08-stp","type":"decouverte","diff":2,"cat":"Cours BTS SIO — S08","level":"BTS SIO SISR 1re année — Bloc 2 — S08","duration":"45 min","title":"S08 — Spanning Tree sur trois commutateurs en triangle","desc":"Trois commutateurs reliés en triangle forment une boucle de niveau 2 : observer l'élection du root bridge, les rôles et états des ports, puis imposer le root bridge de son choix.","objectives":["Identifier le root bridge, les ports racine, désignés et bloqués","Expliquer l'élection (priorité puis adresse MAC) et le choix du port bloqué","Constater la reconvergence après une panne, puis imposer le root bridge par la priorité"],"steps":["Le plan est câblé : SW1, SW2 et SW3 en triangle (SW1 fa0/1 – SW2 fa0/1, SW1 fa0/2 – SW3 fa0/1, SW2 fa0/2 – SW3 fa0/2), un PC sur fa0/3 de chaque commutateur (<code>192.168.1.11</code> à <code>.13</code>). Laissez la simulation converger une trentaine de secondes de temps simulé (<b>+1 min</b>).","Sur chaque commutateur, <code>show spanning-tree</code> : repérez la ligne « This bridge is the root », la priorité (<code>32769</code> = 32768 + numéro de VLAN) et, pour chaque port, le rôle (Root, Desg, Altn) et l'état (FWD, BLK). Quel port est bloqué ? Pourquoi celui-là ?","Les PC se joignent malgré la boucle : <code>ping</code> entre PC1, PC2 et PC3. Le port bloqué empêche la tempête de diffusion mais laisse un chemin unique actif.","Reconvergence : supprimez le câble SW1 – SW2 (clic sur le câble, <b>Supprimer</b>), attendez la convergence, relisez <code>show spanning-tree</code> sur SW2 et SW3 : le port bloqué est-il passé en forwarding ? Rebranchez ensuite le câble (SW1 fa0/1 – SW2 fa0/1).","Le root bridge par défaut est le commutateur de plus petite adresse MAC, ce qui n'est pas un choix d'architecture. Sur <b>SW3</b> : <code>spanning-tree vlan 1 priority 4096</code> (un multiple de 4096). Attendez la reconvergence puis relisez <code>show spanning-tree</code> : SW3 est-il root ? Quel port est maintenant bloqué ?","Contrôlez que le câble SW1 – SW2 est rebranché et testez les pings, puis cliquez sur « Vérifier mon travail ». Dans l'analyseur (liaison entre deux commutateurs), filtre <code>stp</code> : lisez Root Identifier, Root Path Cost et Port identifier."],"checks":[{"t":"cli","label":"SW3 est le root bridge du VLAN 1","dev":"SW3","cmd":"show spanning-tree","match":"This bridge is the root"},{"t":"cli","label":"SW3 a la priorité 4096 (affichée 4097 avec le VLAN)","dev":"SW3","cmd":"show spanning-tree","match":"Bridge ID\\s+Priority\\s+4097"},{"t":"cli","label":"Le triangle est complet : SW1 a deux ports actifs (fa0/1 et fa0/2)","dev":"SW1","cmd":"show spanning-tree","match":"Fa0/1\\s+\\S+\\s+\\S+[\\s\\S]*Fa0/2\\s+\\S+\\s+\\S+"},{"t":"ping","label":"PC1 joint PC2","from":"PC1","to":"192.168.1.12","wait":20000},{"t":"ping","label":"PC1 joint PC3","from":"PC1","to":"192.168.1.13"},{"t":"ping","label":"PC2 joint PC3","from":"PC2","to":"192.168.1.13"}],"solution":{"app":"simulateur-reseau","v":1,"opts":{"strictCables":false,"stpFast":true},"devices":[{"id":"D1","type":"switch","model":"sw-2960","name":"SW1","x":400,"y":100,"powered":true,"cli":"!\nhostname SW1\n!\nspanning-tree mode pvst\nline con 0\n logging synchronous\nline vty 0 4\n!","label":""},{"id":"D2","type":"switch","model":"sw-2960","name":"SW2","x":220,"y":280,"powered":true,"cli":"!\nhostname SW2\n!\nspanning-tree mode pvst\nline con 0\n logging synchronous\nline vty 0 4\n!","label":""},{"id":"D3","type":"switch","model":"sw-2960","name":"SW3","x":580,"y":280,"powered":true,"cli":"!\nhostname SW3\n!\nspanning-tree mode pvst\nspanning-tree vlan 1 priority 4096\nline con 0\n logging synchronous\nline vty 0 4\n!","label":""},{"id":"D4","type":"pc","model":"pc-win","name":"PC1","x":400,"y":20,"powered":true,"ifaces":[{"name":"Ethernet0","ip":"192.168.1.11","mask":"255.255.255.0","dhcp":false}],"gw":"","dns":[],"domain":"","allowIcmpEcho":true,"wifi":{"ssid":"","key":""},"hosts":{},"dhcpd":{"enabled":false,"excluded":[],"pools":[]},"dnsd":{"enabled":false,"records":[],"forwarders":[]},"httpd":{"enabled":false,"https":false,"pages":{"/":{"type":"text/html; charset=utf-8","body":"<html><head><title>PC1</title></head><body><h1>Bienvenue sur PC1</h1><p>Serveur web du simulateur.</p></body></html>"}}},"mgmt":{"comms":[],"location":"","contact":"","syslogd":false,"trapd":false},"v6":{"ifs":[{"name":"Ethernet0","autoconf":true,"addrs":[]}],"statics":[]},"label":""},{"id":"D5","type":"pc","model":"pc-win","name":"PC2","x":100,"y":400,"powered":true,"ifaces":[{"name":"Ethernet0","ip":"192.168.1.12","mas